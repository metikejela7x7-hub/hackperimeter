# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables. SETUP.md explains
# where each one comes from.

# Public URL of the site (no trailing slash). Used in emails and sign-in links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: full database access. Never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails allowed into /admin
ADMIN_EMAILS=

# Resend → API Keys. EMAIL_FROM must use a domain verified in Resend;
# leave it blank to use Resend's test sender (only delivers to your own address).
RESEND_API_KEY=
EMAIL_FROM=

# Discord → exec server → channel settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=
# Invite link included in acceptance emails
DISCORD_INVITE_URL=

# Any long random string. Vercel sends it to the cron routes automatically.
CRON_SECRET=
